# Environment Configuration for Movie Finder Web
# Copy to .env.local when running locally

# Gemini API Key (for server-side scene identification in /api/identify)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: TMDB API Key (for movie posters)
TMDB_API_KEY=

# Supabase Credentials (shared with Android app)
NEXT_PUBLIC_SUPABASE_URL=https://aws-0-eu-west-1.pooler.supabase.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
